        label:                      "NGRL";    
        curve_speed_multiplier:     1;         
        construction_cost:          6;        
		maintenance_cost: 			5;
        speed_limit:                120 km/h;
        acceleration_model:         ACC_MODEL_RAIL;                   
    }
}

//railtype scartamento ridotto elettrificato 2400V
item(FEAT_RAILTYPES) {
    property {
        label:                      "ELNG";
