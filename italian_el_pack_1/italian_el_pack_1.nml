//railtype
item(FEAT_RAILTYPES) {
    property {
        label:                      "TRDL";

		name:						string(STR_3RDRAIL_NAME);
		toolbar_caption:			string(STR_3RDRAIL_TOOLBAR);
		menu_text:					string(STR_3RDRAIL_MENU);
		build_window_caption:		string(STR_3RDRAIL_BUILD_MENU);
		autoreplace_text:			string(STR_3RDRAIL_AUTOREPLACE);
		new_engine_text:			string(STR_3RDRAIL_NEW_ENGINE);
		introduction_date:  		date(1900,1,1);
        compatible_railtype_list:   ["TRDD","TRDL", "TRDT","RAIL"];          
		powered_railtype_list:      ["TRDD","TRDL", "TRDT"];                 
        curve_speed_multiplier:     1;         
        construction_cost:          11;        
		maintenance_cost: 			11;
        speed_limit:                140 km/h;
        acceleration_model:         ACC_MODEL_RAIL;                   
    }
    graphics {
        underlay:   third_rail;
        track_overlay: third_rail_overlay;
        level_crossings: third_rail_pl;
    }
}

//third rail + 3000V DC
item(FEAT_RAILTYPES) {
    property {
        label:                      "TRDD";

		name:						string(STR_3RDRAIL_DC_NAME);
		toolbar_caption:			string(STR_3RDRAIL_DC_TOOLBAR);
		menu_text:					string(STR_3RDRAIL_DC_MENU);
		build_window_caption:		string(STR_3RDRAIL_DC_BUILD_MENU);
		autoreplace_text:			string(STR_3RDRAIL_DC_AUTOREPLACE);
		new_engine_text:			string(STR_3RDRAIL_DC_NEW_ENGINE);
		introduction_date:  		date(1900,1,1);
        compatible_railtype_list:   ["ELRL","TRDL","RAIL"];          
		powered_railtype_list:      ["ELRL","TRDL"];                 
        curve_speed_multiplier:     1;         
        construction_cost:          20;        
		maintenance_cost: 			20;
        speed_limit:                140 km/h;
        acceleration_model:         ACC_MODEL_RAIL;   
        railtype_flags:             bitmask(RAILTYPE_FLAG_CATENARY);                
    }
    graphics {
        underlay:   third_rail;
        track_overlay: third_rail_overlay;
        level_crossings: third_rail_pl;
    }
}

